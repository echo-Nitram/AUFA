# Database
DATABASE_URL="postgresql://aufa:aufa_secret@localhost:5432/aufa?schema=public"

# Auth
# In production both secrets are mandatory, must differ from each other, must be
# at least 32 characters, and must not be these placeholders. The API refuses to
# start otherwise. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV="development"
API_PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Payments
MERCADOPAGO_ACCESS_TOKEN=""
STRIPE_SECRET_KEY=""
AUFA_COMMISSION_RATE=0.04

# File uploads
# Identity documents and medical records are written under UPLOAD_DIR but are
# never served statically: they are reachable only through /api/files.
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Set to 1 to exercise the rate limiters outside production
RATE_LIMIT_IN_DEV=0

# Super Admin
# Also validated as a strong secret in production.
SUPER_ADMIN_EMAIL="admin@aufa.uy"
SUPER_ADMIN_PASSWORD="change-me"
